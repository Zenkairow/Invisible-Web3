DATABASE_URL="postgresql://root:rootpassword@localhost:5432/upi_web3?schema=public"

# The trusted backend key that signs as the "Verifying Signer" / "Authorized Issuer"
VERIFYING_SIGNER_PRIVATE_KEY="your_verifying_signer_key_here"

# The key used to broadcast the UserOperations (The Bundler)
BUNDLER_PRIVATE_KEY="your_bundler_key_here"

# The key used for deploying contracts and funding gas
DEPLOYER_PRIVATE_KEY="your_deployer_key_here"

# Network selection: local, amoy, or mainnet
NETWORK="local"

# Provider URL (Update this for testnet/mainnet, e.g. Alchemy URL)
RPC_URL="http://127.0.0.1:8545"

# Alchemy API Key for Polygon Amoy
ALCHEMY_API_KEY=""

PORT=3000

# JWT Secret — change this for production!
JWT_SECRET="your_jwt_secret_here"

# Transak Fiat On-Ramp (staging)
TRANSAK_API_KEY=""
TRANSAK_API_SECRET=""

# Email SMTP (e.g., Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
